document.addEventListener("DOMContentLoaded", function() {
    // 1. Плавная прокрутка для меню
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
            const target = document.querySelector(this.getAttribute('href'));
            if (target) {
                e.preventDefault();
                target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        });
    });

    // 2. Логика работы формы и окна благодарности
    const form = document.getElementById('contact-form');
    const modal = document.getElementById('thank-you-modal');
    
    if (!form || !modal) return; // Если элементов нет, выходим

    const closeButtons = document.querySelectorAll('#close-modal, #close-modal-btn');

    // Закрытие окна
    closeButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            modal.classList.remove('active');
            document.body.style.overflow = ''; // Возвращаем прокрутку
        });
    });

    // Отправка формы
    form.addEventListener('submit', function(e) {
        e.preventDefault(); // Отменяем перезагрузку страницы
        
        const submitBtn = document.getElementById('submit-btn');
        const originalText = submitBtn.innerText;
        submitBtn.innerText = "Отправка...";
        submitBtn.disabled = true;

        // Создаем скрытый iframe для отправки (обход блокировок браузера)
        const iframe = document.createElement('iframe');
        iframe.name = 'hidden_iframe';
        iframe.style.display = 'none';
        document.body.appendChild(iframe);

        form.target = 'hidden_iframe';
        
        // Отправляем форму (нативный метод)
        HTMLFormElement.prototype.submit.call(form);

        // Через 1.5 секунды показываем окно (FormSubmit обычно успевает за это время)
        setTimeout(() => {
            form.reset(); // Очищаем форму
            form.target = ''; // Возвращаем форму в норму
            modal.classList.add('active'); // Показываем окно
            document.body.style.overflow = 'hidden'; // Блокируем прокрутку
            
            submitBtn.innerText = originalText;
            submitBtn.disabled = false;
            
            document.body.removeChild(iframe); // Удаляем временный iframe
        }, 1500);
    });
});
